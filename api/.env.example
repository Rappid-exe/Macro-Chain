# LLM provider for the causal reasoner. Configure at least one; the
# enrichment pass is optional and degrades gracefully when no key is set.
# Provider preference order: Gemini -> Anthropic.

GOOGLE_API_KEY=
# Optional: override the default model. gemini-2.5-flash is recommended
# for this task — short structured JSON, low latency, cheap.
# GEMINI_MODEL=gemini-2.5-flash

ANTHROPIC_API_KEY=

# Optional: Polymarket and Kalshi API base URLs. Defaults baked in.
POLYMARKET_GAMMA_URL=https://gamma-api.polymarket.com
KALSHI_API_URL=https://api.elections.kalshi.com/trade-api/v2
